# Cloudflare Worker Secrets

# OpenAI API Key (set via: wrangler secret put OPENAI_API_KEY)
# OPENAI_API_KEY=sk-...

# Google OAuth 2.0 Client ID (Web), harus sama dengan VITE_GOOGLE_CLIENT_ID
# di frontend. Dipakai worker untuk memvalidasi ID token masuk.
# (set via: wrangler secret put GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Secret untuk menandatangani session JWT hasil login.
# (set via: wrangler secret put SESSION_SECRET)
# SESSION_SECRET=random-long-random-string

# Optional: custom OpenAI-compatible base URL (default set in wrangler.toml)
# OPENAI_API_URL=https://api.b.ai/v1

# Optional: model name (default set in wrangler.toml)
# OPENAI_MODEL=qwen3.8-flash
